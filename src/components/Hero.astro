---
---

<section class="hero">
  <div class="hero-container">
    <div class="hero-content">
      <h1>Train smarter.<br/>Run stronger.</h1>
      <p class="hero-tagline">Personalized coaching that respects your body and accelerates your potential.</p>
      <a href="#contact" class="btn btn-primary">Book a Free Consultation</a>
    </div>
    <div class="hero-image">
      <picture>
        <source srcset="/images/img-1.webp" type="image/webp" />
        <img src="/images/img-1.jpg" alt="Coach Matt running" width="800" height="1000" />
      </picture>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-height);
  }

  .hero-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero-content {
    max-width: 500px;
  }

  .hero-content h1 {
    margin-bottom: var(--space-4);
  }

  .hero-tagline {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
  }

  .hero-image {
    position: relative;
  }

  .hero-image img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    object-position: center top;
    border-radius: 4px;
  }

  .hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--color-accent);
    border-radius: 4px;
    transform: translate(10px, 10px);
    z-index: -1;
    opacity: 0.5;
  }

  @media (max-width: 968px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--nav-height) + var(--space-8));
      padding-bottom: var(--space-8);
    }

    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-content {
      max-width: 100%;
      order: 1;
    }

    .hero-image {
      order: 0;
      max-width: 320px;
      margin: 0 auto;
    }

    .hero-image img {
      height: 350px;
    }
  }
</style>
