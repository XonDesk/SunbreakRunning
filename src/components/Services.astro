---
const services = [
  {
    title: "Standard Plan",
    features: [
      "Individualized running & strength plans",
      "Daily training modifications & feedback",
      "Weekly calls, unlimited email/text",
      "TrainingPeaks platform access"
    ]
  },
  {
    title: "Basic Plan",
    features: [
      "Individualized running-only plan",
      "Weekly training feedback",
      "Monthly calls, unlimited email/text",
      "TrainingPeaks platform access"
    ]
  },
  {
    title: "1:1 Sessions",
    description: "In-person sessions for workouts, form analysis, trail technique, or strength training. Available in the Seattle area."
  },
  {
    title: "Consultation",
    description: "Expert advice on training, race strategy, nutrition, or anything running related."
  }
];
---

<section id="services" class="services">
  <div class="container">
    <div class="section-header">
      <span class="overline">Services</span>
      <h2>Coaching Options</h2>
    </div>

    <div class="services-grid">
      {services.map(service => (
        <article class="service-card">
          <h3>{service.title}</h3>
          {service.features ? (
            <ul>
              {service.features.map(f => <li>{f}</li>)}
            </ul>
          ) : (
            <p>{service.description}</p>
          )}
        </article>
      ))}
    </div>

    <div class="services-cta">
      <a href="#contact" class="btn btn-primary">Get Started</a>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .overline {
    display: block;
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .service-card {
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: all var(--transition-base);
  }

  .service-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .service-card h3 {
    font-size: var(--font-size-base);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .service-card ul {
    list-style: none;
  }

  .service-card li {
    padding: var(--space-1) 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .service-card li::before {
    content: '✓';
    color: var(--color-accent);
    font-weight: bold;
    flex-shrink: 0;
  }

  .service-card p {
    font-size: var(--font-size-xs);
    line-height: 1.6;
  }

  .services-cta {
    text-align: center;
    margin-top: var(--space-8);
  }

  @media (max-width: 968px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
